# ── BASE DE DATOS ──────────────────────────────────────────

# OPCIÓN A: Desarrollo local (SQLite — archivo local)
# No necesita instalar nada. El archivo db/custom.db se crea solo.
DATABASE_URL="file:./db/custom.db"

# OPCIÓN B: Producción en Vercel (Turso — libSQL en la nube)
# 1. Crear DB gratis en https://turso.tech
# 2. Obtener URL y token con: turso db show e-target --url
# 3. Configurar estas variables en Vercel (Settings → Environment Variables):
# DATABASE_URL="libsql://e-target-<usuario>.turso.io"
# DATABASE_AUTH_TOKEN="<token-de-turso>"


# ── AUTENTICACIÓN JWT ──────────────────────────────────────
# Cualquier texto aleatorio largo (mínimo 32 caracteres).
# Generá uno con: openssl rand -base64 32
JWT_SECRET="cambia-esto-por-un-secreto-aleatorio-muy-largo-de-al-menos-32-caracteres"


# ── MERCADOPAGO (opcional — solo para suscripciones pagas) ─
# Obtener en https://www.mercadopago.com.ar/developers/panel
# MP_ACCESS_TOKEN=""
# MP_PUBLIC_KEY=""

# Modo sandbox (true = pruebas, false = producción)
# MP_SANDBOX="true"
